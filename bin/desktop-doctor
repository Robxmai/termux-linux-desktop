#!/data/data/com.termux/files/usr/bin/bash
set -Eeuo pipefail

if ! TLD_SCRIPT_PATH=$(readlink -f -- "${BASH_SOURCE[0]}"); then
  printf '%s\n' 'FAIL cannot resolve desktop doctor path' >&2
  exit 1
fi
TLD_SCRIPT_DIR=${TLD_SCRIPT_PATH%/bin/*}/bin
TLD_TOOLKIT_ROOT=${TLD_SCRIPT_DIR%/bin}

[[ -n ${PREFIX:-} ]] || {
  printf '%s\n' 'FAIL PREFIX is unset' >&2
  exit 1
}
[[ -n ${HOME:-} ]] || {
  printf '%s\n' 'FAIL HOME is unset' >&2
  exit 1
}

source "$TLD_TOOLKIT_ROOT/lib/tld-common.sh"
source "$TLD_TOOLKIT_ROOT/lib/tld-manifest.sh"
source "$TLD_TOOLKIT_ROOT/lib/tld-guest.sh"

if [[ $# -ne 1 || "${1-}" != '--install-mode' ]]; then
  printf '%s\n' 'FAIL usage: desktop-doctor --install-mode' >&2
  exit 2
fi

TLD_DOCTOR_RESULT=0
TLD_DOCTOR_ROOTFS_DIR=''
TLD_DOCTOR_MANIFEST_FILE=''
TLD_DOCTOR_ROOTFS_MANIFEST_READY=0
TLD_DOCTOR_MANIFEST_VALID=0
TLD_MANIFEST_KEYS=(
  manifest_version
  toolkit_version
  action
  created_at
  status
  architecture
  rootfs_image
  rootfs_container
  profile
  rootfs_manifest_sha256
)

tld_doctor_fail() {
  printf 'FAIL %s\n' "$*"
  TLD_DOCTOR_RESULT=1
}

tld_doctor_valid_created_at() {
  local value="${1-}"
  local normalized

  [[ "$value" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] || return 1
  normalized=$(date -u -d "$value" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null) || return 1
  [[ "$normalized" == "$value" ]]
}

if ! tld_init_managed_paths; then
  tld_doctor_fail 'managed paths could not be initialized'
fi

unset action manifest_version toolkit_version created_at status architecture profile rootfs_image rootfs_container rootfs_manifest_sha256
if [[ -L "${TLD_INSTANCE_FILE:-}" || ! -f "${TLD_INSTANCE_FILE:-}" ]]; then
  tld_doctor_fail "runtime manifest is missing or is not a regular file: ${TLD_INSTANCE_FILE:-unset}"
elif tld_read_env_file "$TLD_INSTANCE_FILE" "${TLD_MANIFEST_KEYS[@]}" &&
  [[ "${manifest_version-}" == 1 &&
    "${toolkit_version-}" == 0.1.0 &&
    "${action-}" == install &&
    "${status-}" == installed &&
    "${architecture-}" == aarch64 &&
    "${profile-}" == base &&
    "${rootfs_image-}" == ubuntu:24.04 &&
    "${rootfs_container-}" == tld-ubuntu &&
    "${rootfs_manifest_sha256-}" =~ ^[0-9A-Fa-f]{64}$ ]] &&
  tld_doctor_valid_created_at "${created_at-}"; then
  TLD_DOCTOR_MANIFEST_VALID=1
  printf 'PASS runtime manifest status=%s action=%s profile=%s\n' "$status" "$action" "$profile"
else
  tld_doctor_fail 'runtime manifest is missing required installed base values'
fi

if _tld_guest_prepare_paths && _tld_guest_load_rootfs_env; then
  if TLD_DOCTOR_ROOTFS_DIR=$(_tld_guest_rootfs_dir); then
    if [[ -d "$TLD_DOCTOR_ROOTFS_DIR" && ! -L "$TLD_DOCTOR_ROOTFS_DIR" ]]; then
      printf 'PASS rootfs directory=%s\n' "$TLD_DOCTOR_ROOTFS_DIR"
      if TLD_DOCTOR_MANIFEST_FILE=$(_tld_guest_manifest_path "$TLD_DOCTOR_ROOTFS_DIR") &&
        [[ ! -L "$TLD_DOCTOR_MANIFEST_FILE" && -r "$TLD_DOCTOR_MANIFEST_FILE" ]]; then
        printf 'PASS rootfs manifest=%s\n' "$TLD_DOCTOR_MANIFEST_FILE"
        TLD_DOCTOR_ROOTFS_MANIFEST_READY=1
      else
        tld_doctor_fail "rootfs manifest is missing or is a symlink: $TLD_DOCTOR_ROOTFS_DIR"
      fi
    else
      tld_doctor_fail "rootfs directory is missing or is a symlink: $TLD_DOCTOR_ROOTFS_DIR"
    fi
  else
    tld_doctor_fail 'rootfs path could not be derived from the pinned environment'
  fi
else
  tld_doctor_fail 'pinned rootfs environment could not be loaded'
fi

if (( TLD_DOCTOR_MANIFEST_VALID == 1 && TLD_DOCTOR_ROOTFS_MANIFEST_READY == 1 )); then
  if actual_digest=$(sha256sum "$TLD_DOCTOR_MANIFEST_FILE"); then
    if read -r actual_hash _ <<< "$actual_digest" &&
      [[ "$actual_hash" =~ ^[0-9A-Fa-f]{64}$ &&
        "${actual_hash,,}" == "${rootfs_manifest_sha256,,}" ]]; then
      printf 'PASS rootfs manifest SHA-256=%s\n' "$actual_hash"
    else
      tld_doctor_fail 'rootfs manifest SHA-256 mismatch'
    fi
  else
    tld_doctor_fail 'rootfs manifest SHA-256 could not be computed'
  fi
fi

if [[ -n "$TLD_DOCTOR_ROOTFS_DIR" &&
  -f "$TLD_DOCTOR_ROOTFS_DIR/usr/local/lib/termux-linux-desktop/start-guest.sh" &&
  ! -L "$TLD_DOCTOR_ROOTFS_DIR/usr/local/lib/termux-linux-desktop/start-guest.sh" &&
  -x "$TLD_DOCTOR_ROOTFS_DIR/usr/local/lib/termux-linux-desktop/start-guest.sh" ]]; then
  printf 'PASS guest launcher=%s\n' "$TLD_DOCTOR_ROOTFS_DIR/usr/local/lib/termux-linux-desktop/start-guest.sh"
else
  tld_doctor_fail "guest launcher is missing or not executable: ${TLD_DOCTOR_ROOTFS_DIR:-unknown}/usr/local/lib/termux-linux-desktop/start-guest.sh"
fi

printf '%s\n' 'WARN GPU/Wine checks skipped in install mode; neither is required by the base profile'
exit "$TLD_DOCTOR_RESULT"
